
import os
import asyncio
import requests
from telethon import TelegramClient, events

API_ID = int(os.environ["API_ID"])
API_HASH = os.environ["API_HASH"]
BOT_TOKEN = os.environ["BOT_TOKEN"]

SOURCE = "Sportplus_Tv"
DESTINATION = "@sportslive1"

client = TelegramClient("news_session", API_ID, API_HASH)

async def main():
    await client.start()

    @client.on(events.NewMessage(chats=SOURCE))
    async def forward_news(event):
        text = event.raw_text or ""

        if not text.strip():
            return

        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"

        response = requests.post(
            url,
            data={
                "chat_id": DESTINATION,
                "text": text + "\n\n📡 المصدر: @Sportplus_Tv",
                "disable_web_page_preview": False
            },
            timeout=20
        )

        if not response.ok:
            print("فشل النشر:", response.text)
        else:
            print("تم نشر خبر جديد")

    print("تم تشغيل نظام نقل الأخبار")
    await client.run_until_disconnected()

asyncio.run(main())
